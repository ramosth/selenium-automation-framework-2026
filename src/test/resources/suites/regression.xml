<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Suíte completa (padrão do "mvn test"). Roda todos os módulos. -->
<suite name="Regressão - Sauce Demo" verbose="1">
    <test name="Login">
        <classes>
            <class name="com.test.automation.tests.login.LoginTest" />
            <class name="com.test.automation.tests.login.LoginTestData" />
        </classes>
    </test>
    <test name="Carrinho e Checkout">
        <classes>
            <class name="com.test.automation.tests.cart.CartTest" />
            <class name="com.test.automation.tests.checkout.CheckoutTest" />
            <class name="com.test.automation.tests.checkout.OrderSummaryTest" />
            <class name="com.test.automation.tests.cart.RemoveFromCartTest" />
            <class name="com.test.automation.tests.cart.CartPersistenceTest" />
            <class name="com.test.automation.tests.checkout.CancelCheckoutTest" />
            <class name="com.test.automation.tests.checkout.OrderReceiptPdfTest" />
        </classes>
    </test>
    <test name="Produtos">
        <classes>
            <class name="com.test.automation.tests.inventory.ProductDetailsTest" />
        </classes>
    </test>
    <test name="Navegação">
        <classes>
            <class name="com.test.automation.tests.navigation.SideMenuTest" />
            <class name="com.test.automation.tests.navigation.FooterTest" />
        </classes>
    </test>
    <test name="Dynamic Catalog">
        <classes>
            <class name="com.test.automation.tests.dynamiccatalog.SpinnerTest" />
            <class name="com.test.automation.tests.dynamiccatalog.LazyLoadTest" />
            <class name="com.test.automation.tests.dynamiccatalog.SliderTest" />
        </classes>
    </test>
</suite>